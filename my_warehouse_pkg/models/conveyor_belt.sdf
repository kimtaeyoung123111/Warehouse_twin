            <uri>https://fuel.gazebosim.org/1.0/Open-RMF/models/conveyor_block</uri>
            <pose>2.25 0 0 0 0 1.5707</pose>
            <static>true</static>
        </include>

        <!--
        <include>
            <pose relative_to="tray_start">0 0 0 0 0 0</pose> 
            <uri>https://fuel.gazebosim.org/1.0/Open-RMF/models/tray</uri>
        </include>
        -->

    </model>
</sdf>
