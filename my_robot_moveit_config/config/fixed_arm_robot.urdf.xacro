<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fixed_arm_robot">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import fixed_arm_robot urdf file -->
    <xacro:include filename="$(find my_warehouse_pkg)/models/fixed_ur5e_vacuum.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="fixed_arm_robot.ros2_control.xacro" />


    <xacro:fixed_arm_robot_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
